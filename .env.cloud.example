# AMBIENTE CLOUD (AWS EC2 + Amazon RDS): el mismo docker-compose.yml, pero la base de datos es RDS.
# En la EC2:  cp .env.cloud.example .env && nano .env && chmod 600 .env
# El .env NUNCA se sube a Git ni se copia por SCP desde tu PC: se escribe directamente en el servidor.

# Sin perfiles: NO se levanta el contenedor de PostgreSQL (la base es RDS)
COMPOSE_PROFILES=

# Puerto del balanceador. En el grupo de seguridad de la EC2 ábrelo solo para tu IP (y la del docente).
PUERTO_APP=8080
PUBLIC_URL=http://IP_ELASTICA:8080

# Amazon RDS: punto de enlace de la consola de RDS (Conectividad y seguridad). La base NO es pública:
# solo acepta conexiones desde el grupo de seguridad de la EC2. sslmode=require cifra la conexión.
DB_HOST=petadopt-db.xxxxxxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=petadopt
DB_USER=petadopt
DB_PASSWORD=
DB_PARAMS=?sslmode=require

# Firma de las sesiones (JWT): mínimo 32 caracteres. Generarlo en la EC2:  openssl rand -base64 48
JWT_SECRET=

# Fotos en Amazon S3 (usuario IAM petadopt-backend)
S3_REGION=us-east-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Memoria de cada réplica. En una t3.small (2 GB) caben las dos con -Xmx384m.
# JAVA_OPTS=-Xms128m -Xmx384m

# Etiqueta de las imágenes (Fase 4: v1, v2 y rollback). Para volver a la anterior: VERSION=v1 y docker compose up -d
VERSION=v1
