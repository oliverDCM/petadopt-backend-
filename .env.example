# AMBIENTE ON-PREMISE (VirtualBox + Ubuntu Server, o tu PC): base de datos PostgreSQL en un contenedor con volumen.
# Copia este archivo como .env (junto a docker-compose.yml) y completa los valores. El .env NUNCA se sube a Git.
#   cp .env.example .env && nano .env && chmod 600 .env

# Perfiles: db-local levanta PostgreSQL en contenedor. En tu PC puedes añadir herramientas (pgAdmin y SonarQube):
#   COMPOSE_PROFILES=db-local,herramientas
COMPOSE_PROFILES=db-local

# Puerto del balanceador (único puerto publicado) y dirección con la que se abre la app desde el navegador.
# En la VM usa la IP de Ubuntu (ip -4 addr) o, con NAT + reenvío de puertos, http://localhost:8080.
# En tu PC, para las pruebas E2E de siempre: PUERTO_APP=4200 y PUBLIC_URL=http://localhost:4200
PUERTO_APP=8080
PUBLIC_URL=http://192.168.1.50:8080

# Base de datos (contenedor db). Si ya tenías el proyecto corriendo, deja la contraseña que venías usando:
# PostgreSQL la guardó al crear el volumen y no la cambia sola.
DB_NAME=petadopt
DB_USER=petadopt
DB_PASSWORD=

# Firma de las sesiones (JWT): mínimo 32 caracteres, aleatorio. Generarlo en Linux:  openssl rand -base64 48
JWT_SECRET=

# Fotos en Amazon S3 (usuario IAM petadopt-backend). Las dos réplicas usan el mismo bucket.
S3_REGION=us-east-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Opcional: para correr las pruebas E2E varias veces seguidas (por defecto 3 por hora)
# RECUPERACION_MAX_INTENTOS=100

# Etiqueta de las imágenes (Fase 4: v1, v2 y rollback). Para volver a la anterior: VERSION=v1 y docker compose up -d
VERSION=v1
