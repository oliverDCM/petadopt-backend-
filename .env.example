# Copia este archivo como .env (junto a docker-compose.yml) y completa los valores. El .env nunca se sube a Git.

# Base de datos. Si ya tenías el proyecto corriendo, deja la contraseña que venías usando (123456):
# PostgreSQL la guardó al crear el volumen y no la cambia sola. Para cambiarla de verdad:
#   docker compose exec db psql -U petadopt -c "ALTER USER petadopt PASSWORD 'la-nueva'"   y luego actualiza este valor.
POSTGRES_DB=petadopt
POSTGRES_USER=petadopt
POSTGRES_PASSWORD=

# Firma de las sesiones (JWT): mínimo 32 caracteres, aleatorio y distinto en cada equipo.
# Generar uno en PowerShell:  -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 48 | % { [char]$_ })
JWT_SECRET=

# Fotos en Amazon S3 (usuario IAM petadopt-backend)
S3_REGION=us-east-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Opcional: para correr las pruebas E2E varias veces seguidas (por defecto 3 por hora)
# RECUPERACION_MAX_INTENTOS=100
