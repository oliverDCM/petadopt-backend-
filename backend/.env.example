# Copia este archivo a .env (no se sube al repositorio) y completa los valores.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/petadopt
SPRING_DATASOURCE_USERNAME=petadopt
SPRING_DATASOURCE_PASSWORD=
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
# En producción: SWAGGER_ENABLED=false y JPA_DDL_AUTO=validate
