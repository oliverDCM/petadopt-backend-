# Copia este archivo a .env (no se sube al repositorio) y completa los valores.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/petadopt
SPRING_DATASOURCE_USERNAME=petadopt
SPRING_DATASOURCE_PASSWORD=
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
# Fotos en Amazon S3: usuario IAM con permiso s3:PutObject sobre el bucket (nunca las llaves de la cuenta raíz)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Opcionales: solo para Cloudflare R2, MinIO u otro servicio compatible con S3
S3_ENDPOINT=
S3_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Correo (HU-BE-22). En desarrollo: Mailpit, sin usuario ni clave.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=PetAdopt <no-reply@petadopt.local>
# Con Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true
# y en MAIL_PASSWORD una "contraseña de aplicación" (nunca tu contraseña normal).

# Base de los enlaces de recuperación de contraseña (pantalla del frontend)
FRONTEND_URL=http://localhost:4200

# Logs (HU-BE-19). Por defecto se guardan FUERA del proyecto, en ../logs/backend/petadopt.log
# (carpeta petadopt/logs/backend). Para otra ubicación usa una ruta absoluta, p. ej. C:/petadopt-logs/petadopt.log
LOG_LEVEL_APP=INFO
LOG_FILE=

# En producción: SWAGGER_ENABLED=false y JPA_DDL_AUTO=validate
