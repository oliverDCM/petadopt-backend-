# Plantilla del archivo ~/petadopt/.env del servidor EC2.
# En el servidor:  nano ~/petadopt/.env  y pega esto con tus valores. NUNCA lo subas a GitHub.

# Dueño de las imágenes en GHCR, en minúsculas (tu usuario de GitHub)
GHCR_OWNER=oliverdcm

# Dirección pública de la app (IP elástica de EC2), sin barra final
PUBLIC_URL=http://3.140.0.0

# Base de datos en Amazon RDS: el "Punto de enlace" (Endpoint) que muestra la consola de RDS
DB_HOST=petadopt-db.xxxxxxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=petadopt
DB_USER=petadopt
DB_PASSWORD=

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Fotos en Amazon S3 (las mismas llaves del usuario IAM petadopt-backend)
S3_REGION=us-east-2
S3_BUCKET=petadopt-fotos-oliver
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Correo: vacío = Mailpit del servidor. Para correos reales con Gmail:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=contraseña_de_aplicacion
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=PetAdopt <tu_correo@gmail.com>

# Para volver a una versión anterior: pon aquí el SHA del commit y ejecuta "docker compose ... up -d"
# BACKEND_TAG=latest
# FRONTEND_TAG=latest
